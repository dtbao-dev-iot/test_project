#!/usr/bin/env bash
# pre-commit: Run clang-format check on all staged .c / .h files
# Part of dtbao-IoT project setup — do not remove

set -e

CLANG_FORMAT=$(command -v clang-format 2>/dev/null || true)

if [ -z "$CLANG_FORMAT" ]; then
    echo ""
    echo "[pre-commit] WARNING: clang-format not found. Skipping style check."
    echo "  Install on Linux : sudo apt install clang-format"
    echo "  Install on Windows: choco install llvm"
    echo ""
    exit 0
fi

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(c|h)$' || true)

if [ -z "$STAGED_FILES" ]; then
    exit 0
fi

FORMAT_ERRORS=0

for FILE in $STAGED_FILES; do
    if ! "$CLANG_FORMAT" --dry-run --Werror "$FILE" 2>/dev/null; then
        echo "[pre-commit] Style error: $FILE"
        FORMAT_ERRORS=$((FORMAT_ERRORS + 1))
    fi
done

if [ "$FORMAT_ERRORS" -gt 0 ]; then
    echo ""
    echo "[pre-commit] $FORMAT_ERRORS file(s) have formatting issues."
    echo ""
    echo "  Fix a single file : clang-format -i <file>"
    echo "  Fix all staged    : git diff --cached --name-only | grep -E '\.(c|h)$' | xargs clang-format -i"
    echo "  Then re-stage     : git add <files>"
    echo ""
    exit 1
fi

exit 0